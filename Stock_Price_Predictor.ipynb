          "output_type": "stream",
          "text": [
            "Train Score: 0.7406 MSE (0.8606 RMSE)\n",
            "Test Score: 0.33573317 MSE (0.57942486 RMSE)\n"
          ]
        }
      ],
      "source": [
        "trainScore = mean_squared_error(X_train, y_train)\n",
        "print('Train Score: %.4f MSE (%.4f RMSE)' % (trainScore, math.sqrt(trainScore)))\n",
        "\n",
        "testScore = mean_squared_error(predictions, y_test)\n",
        "print('Test Score: %.8f MSE (%.8f RMSE)' % (testScore, math.sqrt(testScore)))"
      ]
    },
