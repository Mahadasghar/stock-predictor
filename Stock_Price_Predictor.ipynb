          "text": [
            "x_train (2155, 1)\n",
            "y_train (2155, 1)\n",
            "x_test (990, 1)\n",
            "y_test (990, 1)\n"
          ]
        }
      ],
      "source": [
        "X_train, X_test, y_train, y_test, label_range= sd.train_test_split_linear_regression(stocks)\n",
        "\n",
        "print(\"x_train\", X_train.shape)\n",
        "print(\"y_train\", y_train.shape)\n",
        "print(\"x_test\", X_test.shape)\n",
        "print(\"y_test\", y_test.shape)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "KMYAe-Olk3ld"
      },
      "source": [
        "**Step 3:** Train a Linear regressor model on training set and get prediction"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 13,
      "metadata": {
        "id": "WjiIxkwEk3le"
      },
      "outputs": [],
      "source": [
        "model = LinearRegressionModel.build_model(X_train,y_train)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "dOC73pJFk3le"
      },
      "source": [
        "**Step 4:** Get prediction on test set"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 14,
      "metadata": {
        "id": "x_VDZDQfk3lf"
      },
      "outputs": [],
      "source": [
        "predictions = LinearRegressionModel.predict_prices(model,X_test, label_range)"
      ]
    },
