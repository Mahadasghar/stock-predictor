      "source": [
        "# Evaluate the model\n",
        "train_mse_lasso = mean_squared_error(y_train, lasso_model.predict(X_train))\n",
        "test_mse_lasso = mean_squared_error(y_test, lasso_model.predict(X_test))\n",
        "test_rmse_lasso = math.sqrt(test_mse_lasso)\n",
        "print(f'Model 30 - Train Score: {train_mse_lasso:.8f} MSE')\n",
        "print(f'Model 30 - Test Score: {test_mse_lasso:.8f} MSE')\n",
        "print(f'Model 30 - Test Score: {test_rmse_lasso:.8f} RMSE')"
