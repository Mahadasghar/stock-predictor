            "NaN in y_test: 0\n"
          ]
        }
      ],
      "source": [
        "print(\"NaN in X_train:\", np.isnan(X_train).sum())\n",
        "print(\"NaN in X_test:\", np.isnan(X_test).sum())\n",
        "print(\"NaN in y_train:\", np.isnan(y_train).sum())\n",
        "print(\"NaN in y_test:\", np.isnan(y_test).sum())\n"
      ]
